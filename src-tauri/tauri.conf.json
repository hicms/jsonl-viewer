{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSONL Viewer",
  "version": "2.0.0",
  "identifier": "dev.jsonl.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "JSONL Viewer", "width": 1280, "height": 840, "minWidth": 720, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../LICENSE": "LICENSE", "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt" },
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["jsonl", "ndjson"], "name": "JSON Lines", "description": "JSON Lines data", "role": "Viewer" }],
    "shortDescription": "JSON Lines and agent session viewer"
  }
}
